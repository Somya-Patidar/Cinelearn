# CineLearn Environment Configuration
# All model providers, API keys, and stage configurations are managed here.

# ============================================================================
# Global LLM Selection (Model-Agnostic)
# ============================================================================
# Default LLM provider across all stages unless overridden per-stage below.
# Supported providers: gemini | ollama | openai
LLM_PROVIDER=gemini

# Default model identifier for the selected provider
# Examples:
#   Gemini:  gemini-3.8-flash, gemini-2.5-flash, gemini-2.5-pro
#   Ollama:  qwen2.5:7b, qwen2.5-coder:7b, qwen3:8b, llama3.2
#   OpenAI:  gpt-4o, gpt-4o-mini
LLM_MODEL=gemini-3.8-flash

# Optional path to stage-specific YAML/JSON configuration file
# LLM_CONFIG_FILE=llm_config.yaml

# ============================================================================
# Google Gemini API
# Get your free key at: https://aistudio.google.com/apikey
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Gemini Quota & Rate Limiting Controls
# GEMINI_RPM_LIMIT=5
# GEMINI_RPM_SAFETY_MARGIN=1
# GEMINI_RPD_LIMIT=20
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ============================================================================
# Local Models via Ollama (Open-Weight Models, e.g. Qwen)
#
# Installation & Setup:
#   1. Install Ollama: curl -fsSL https://ollama.com/install.sh | sh
#   2. Start Ollama service: ollama serve
#   3. Pull desired model(s):
#      ollama pull qwen2.5:7b
#      ollama pull qwen2.5-coder:7b
# ============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5-coder:7b

# ============================================================================
# OpenAI & Compatible Providers (vLLM, DeepSeek, Groq, LocalAI)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ============================================================================
# Stage-Specific Model Routing Overrides (Optional)
# Configure different models for different stages of CineLearn without
# modifying any source code. If unset, stages fall back to LLM_PROVIDER/LLM_MODEL.
# ============================================================================
# STAGE_OUTLINE_PROVIDER=gemini
# STAGE_OUTLINE_MODEL=gemini-3.8-flash

# STAGE_STORYBOARD_PROVIDER=ollama
# STAGE_STORYBOARD_MODEL=qwen2.5:7b

# STAGE_CODE_GENERATION_PROVIDER=ollama
# STAGE_CODE_GENERATION_MODEL=qwen2.5-coder:7b

# STAGE_VERIFICATION_PROVIDER=gemini
# STAGE_VERIFICATION_MODEL=gemini-3.8-flash

# STAGE_REPAIR_PROVIDER=ollama
# STAGE_REPAIR_MODEL=qwen2.5-coder:7b

# STAGE_EVALUATION_PROVIDER=gemini
# STAGE_EVALUATION_MODEL=gemini-3.8-flash

# ============================================================================
# Visual Assets API (Optional)
# By default, CineLearn uses Iconify (https://api.iconify.design),
# which is 100% FREE and requires NO API KEY.
# ============================================================================
ICONFINDER_API_KEY=
